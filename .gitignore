# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local development data (not synced)
/.local/
# Claude Code: keep local settings private, version shared skills
/.claude/*
!/.claude/skills/
supabase/.temp/
supabase/dumps/

# Electron desktop build
/bin/
/dist-electron/
/.INSTALL/
/INSTALL/

# merch render scratch
/scripts/merch/.render.html
/scripts/merch/.review.png

# Crystal pipeline work dir (dumps, raw GLBs, previews)
/.crystal/
# Crystal build output (~180 MB GLB) — kept out of git until the distribution
# (LFS / release asset / CDN) is decided; rebuild with `pnpm crystal:build`.
/public/crystal/
# Textures derived from the private reference portrait (never in the repo;
# rebuild locally: node scripts/hero/face-texture.mjs, scripts/hero/blender/jade_mpfb.py)
/public/hero/jade-face.webp
/public/hero/jade-skin.jpg
