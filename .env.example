# Supabase (Public - exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Private - server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana NFT mint (Private - server only, devnet)
# RPC endpoint; defaults to the public devnet endpoint when unset.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Content of a funded devnet keypair file (solana-keygen new) —
# a JSON array of 64 numbers. NEVER a mainnet key, NEVER committed.
SOLANA_MINT_KEYPAIR=[1,2,3,...]
