{
  "name": "unlabs",
  "version": "0.4.0-beta",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "merch:render": "node scripts/merch/render.ts",
    "crystal:export": "vite-node --config scripts/audio/vite.config.mjs scripts/crystal/export.ts",
    "crystal:build": "vite-node --config scripts/audio/vite.config.mjs scripts/crystal/build.ts",
    "crystal:assemble": "vite-node --config scripts/audio/vite.config.mjs scripts/crystal/assemble-bots.ts",
    "crystal:doors": "vite-node --config scripts/audio/vite.config.mjs scripts/crystal/doors.ts",
    "crystal:library": "uv run --quiet --script scripts/crystal/library/scan.py",
    "crystal:textures": "node scripts/crystal/blender.mjs textures",
    "crystal:blender": "node scripts/crystal/blender.mjs gui",
    "crystal:mcp": "uv run --script scripts/crystal/mcp/server.py",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > types/database.generated.ts && prettier --write types/database.generated.ts",
    "electron:dev": "concurrently \"next dev\" \"npx tsc -p electron/tsconfig.json -w\" \"npx wait-on http://localhost:3000 && electron dist-electron/main.js\"",
    "electron:compile": "npx tsc -p electron/tsconfig.json",
    "download:binaries": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' npx ts-node scripts/download-binaries.ts",
    "build:mac": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' npx ts-node scripts/build-desktop.ts --mac",
    "build:win": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' npx ts-node scripts/build-desktop.ts --win",
    "build:linux": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' npx ts-node scripts/build-desktop.ts --linux",
    "build:all": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' npx ts-node scripts/build-desktop.ts --all",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-port": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.563.0",
    "next": "16.3.7",
    "pg": "^8.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4",
    "@gltf-transform/extensions": "^4",
    "@gltf-transform/functions": "^4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "lefthook": "^1.8.5",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.3"
  },
  "pnpm": {
    "overrides": {
      "ws@>=7.0.0 <7.5.11": "^7.5.13",
      "ws@>=8.0.0 <8.21.0": "^8.22.0",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "@babel/core@<7.29.6": "^7.29.7",
      "browserslist@<4.28.7": "^4.29.3",
      "baseline-browser-mapping@<2.11.0": "^2.11.26"
    }
  }
}
