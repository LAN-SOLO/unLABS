  "bindings": [
    {
      "class": "glass",
      "match": "^crystal_",
      "surface": "crystal"
    },
    {
      "class": "emit",
      "surface": "emissive"
    },
    {
      "class": "glass",
      "surface": "glass"
    },
    {
      "match": "^(chrome|goggles)",
      "surface": "chrome"
    },
    {
      "match": "^(copper|brass|gold|bronze)",
      "surface": "warm_metal"
    },
    {
      "match": "^(rust|iron_rust)",
      "surface": "rust"
    },
    {
      "match": "^(steel|aluminium|metal_light|floor_grate)",
      "surface": "steel"
    },
    {
      "class": "metal",
      "surface": "painted_metal"
    },
    {
      "match": "^(rubber|cable_|tire|shoes)",
      "surface": "rubber"
    },
    {
      "match": "^(wood|oak|walnut|root)",
      "surface": "wood"
    },
    {
      "match": "^(fabric_|carpet_|coat_|pants_|jeans|sweater_|scarf_|vest_)",
      "surface": "fabric"
    },
    {
      "match": "^leather",
      "surface": "leather"
    },
    {
      "match": "^(paper|cardboard|book_|badge_)",
      "surface": "paper"
    },
    {
      "match": "^(tile_|ceramic|pot$|white$)",
      "surface": "ceramic"
    },
    {
      "match": "^(concrete|asphalt|brick|mortar|rock|floor_|wall|trim_|dust|grime)",
      "surface": "masonry"
    },
    {
      "match": "^(plant_|leaf_|flower_|soil|coffee)",
      "surface": "organic"
    },
    {
      "match": "^(skin|lips|eye_)",
      "surface": "skin"
    },
    {
      "match": "^(hair_|lid_)",
      "surface": "hair"
    },
    {
      "match": ".*",
      "surface": "plastic"
    }
  ]
}
